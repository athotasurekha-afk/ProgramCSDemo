{
  "openapi": "3.0.1",
  "info": {
    "title": "ProgramCSDemo | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:5232"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "tags": [
          "ProgramCSDemo"
        ],
        "summary": "Get service status",
        "operationId": "GetServiceStatus",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnonymousTypeOfstringAndstring"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "ProgramCSDemo"
        ],
        "summary": "Check process liveness",
        "operationId": "GetHealth",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnonymousTypeOfstring"
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "tags": [
          "ProgramCSDemo"
        ],
        "summary": "Check link-store readiness",
        "description": "Verifies that the configured link store is writable.",
        "operationId": "GetReadiness",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/links": {
      "post": {
        "tags": [
          "ProgramCSDemo"
        ],
        "summary": "Create a short link",
        "description": "Creates a random code or reserves a requested custom code. Supply a stable Idempotency-Key to safely retry a create request.",
        "operationId": "CreateShortLink",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateShortLinkRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShortLinkResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/{code}": {
      "get": {
        "tags": [
          "ProgramCSDemo"
        ],
        "summary": "Redirect to the original URL",
        "description": "Returns a temporary redirect and records a click. Expired links return 410 Gone.",
        "operationId": "RedirectShortLink",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "404": {
            "description": "Not Found"
          },
          "302": {
            "description": "Found"
          },
          "410": {
            "description": "Gone",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/links/{code}/analytics": {
      "get": {
        "tags": [
          "ProgramCSDemo"
        ],
        "summary": "Get click analytics for a short link",
        "description": "Returns aggregate click metrics without exposing the destination URL.",
        "operationId": "GetLinkAnalytics",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LinkAnalyticsResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AnonymousTypeOfstring": {
        "required": [
          "status"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "AnonymousTypeOfstringAndstring": {
        "required": [
          "service",
          "status"
        ],
        "type": "object",
        "properties": {
          "service": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "CreateShortLinkRequest": {
        "required": [
          "originalUrl"
        ],
        "type": "object",
        "properties": {
          "originalUrl": {
            "maxLength": 2048,
            "type": "string",
            "nullable": true
          },
          "customCode": {
            "maxLength": 32,
            "type": "string",
            "nullable": true
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "HealthResponse": {
        "required": [
          "status"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          }
        }
      },
      "LinkAnalyticsResponse": {
        "required": [
          "code",
          "clickCount",
          "createdAt",
          "expiresAt",
          "lastClickedAt"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "clickCount": {
            "type": "integer",
            "format": "int64"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "lastClickedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "instance": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "ShortLinkResponse": {
        "required": [
          "code",
          "redirectPath",
          "createdAt",
          "expiresAt"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "redirectPath": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "ProgramCSDemo"
    }
  ]
}