{
  "UrlShortener": {
    "DataPath": "App_Data/links.json"
  },
  "RateLimiting": {
    "Create": {
      "PermitLimit": 30,
      "WindowSeconds": 60
    },
    "Redirect": {
      "PermitLimit": 300,
      "WindowSeconds": 60
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
